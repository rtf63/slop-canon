---
// Base HTML shell: <head>, fonts, SEO/OG, global styles, header + footer.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or site-relative URL of the share image (the rendered artwork). */
  ogImage?: string;
  /** Active nav item for aria-current. */
  nav?: 'today' | 'prints';
}

const {
  title = 'Slop Canon',
  description = 'Every morning a machine writes one poem, informed by the day’s news. That’s the whole website.',
  ogImage,
  nav,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageAbs = ogImage ? new URL(ogImage, Astro.site).href : undefined;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph / Twitter: the rendered artwork is the share image -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Slop Canon" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {ogImageAbs && <meta property="og:image" content={ogImageAbs} />}
  <meta name="twitter:card" content={ogImageAbs ? 'summary_large_image' : 'summary'} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <link rel="alternate" type="application/rss+xml" title="Slop Canon" href="/rss.xml" />

  <!-- Fonts. TODO(M3): self-host via @fontsource for privacy + perf (drops this
       external request). Kept as the mockup's Google Fonts link for M1 fidelity. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Fraunces:ital,opsz,wght@0,9..144,500;1,9..144,400;1,9..144,500&family=Instrument+Sans:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header nav={nav} />
  <slot name="marquee" />
  <main id="main">
    <slot />
  </main>
  <Footer />
</body>
</html>
