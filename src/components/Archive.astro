---
import PoemCard from './PoemCard.astro';
import Receipt from './Receipt.astro';
import { issueLabel, issueSlug, dayLabel } from '../lib/format';
import { SUBSTACK_URL } from '../lib/site';
import type { CollectionEntry } from 'astro:content';

interface Props { entries: CollectionEntry<'entries'>[]; }
const { entries } = Astro.props;
---
<section id="archive" class="wrap">
  <div class="band-label">
    <span class="txt">The Archive</span>
    <span class="rule"></span>
    <span class="chip blue">{entries.length} {entries.length === 1 ? 'poem' : 'poems'}</span>
  </div>

  {entries.length > 0 ? (
    <div class="archive-grid">
      {entries.map((e) => (<PoemCard entry={e} />))}
    </div>
  ) : (
    <p class="archive-empty">The archive fills as the days go by. Come back tomorrow.</p>
  )}

  <p class="archive-more"><a href={SUBSTACK_URL} target="_blank" rel="noopener">Every poem also lands in your inbox on Substack →</a></p>

  {/* Hidden full-content per entry, cloned into the drawer on click. Cards remain
     links to /day/NNN, so with JS off (or ⌘-click) they still open as pages. */}
  <div hidden>
    {entries.map((e) => (
      <template id={`entry-${e.data.issue}`}>
        <div class="drawer-content" data-weather={e.data.weather}>
          <div class="drawer-head">
            <span class="drawer-issue">{issueLabel(e.data.issue)}</span>
            <span class="drawer-date">{dayLabel(e.data.date)}</span>
          </div>
          <h3 class="drawer-title">{e.data.title}</h3>
          <div class="poem">{e.data.poem}<span class="by">— written by {e.data.provenance.madeBy}</span></div>
          <Receipt issue={e.data.issue} provenance={e.data.provenance} />
          <a class="drawer-permalink" href={`/day/${issueSlug(e.data.issue)}`}>Open as its own page →</a>
        </div>
      </template>
    ))}
  </div>

  <dialog class="drawer" id="archive-drawer" aria-label="Archived poem">
    <div class="drawer-topbar">
      <div class="drawer-pager">
        <button class="drawer-nav" id="drawer-prev" type="button" aria-label="Older poem" title="Older">←</button>
        <button class="drawer-nav" id="drawer-next" type="button" aria-label="Newer poem" title="Newer">→</button>
      </div>
      <button class="drawer-close" id="drawer-close" type="button" aria-label="Close">✕</button>
    </div>
    <div class="drawer-body" id="drawer-body"></div>
  </dialog>
</section>

<script>
  (function () {
    const drawer = document.getElementById('archive-drawer');
    const bodyEl = document.getElementById('drawer-body');
    const closeBtn = document.getElementById('drawer-close');
    const prevBtn = document.getElementById('drawer-prev');
    const nextBtn = document.getElementById('drawer-next');
    if (!(drawer instanceof HTMLDialogElement) || !bodyEl) return;

    // Display order (newest → oldest, so index increases going older).
    // ← (prev) descends to older; → (next) climbs to newer.
    const order = Array.from(document.querySelectorAll('.poem-card-mini[data-issue]'))
      .map((c) => c.getAttribute('data-issue'));
    let idx = -1;

    const render = (i: number) => {
      const tpl = document.getElementById('entry-' + order[i]);
      if (!(tpl instanceof HTMLTemplateElement)) return;
      bodyEl.replaceChildren(tpl.content.cloneNode(true));
      idx = i;
      drawer.scrollTop = 0;
      if (prevBtn instanceof HTMLButtonElement) prevBtn.disabled = i >= order.length - 1; // ← older
      if (nextBtn instanceof HTMLButtonElement) nextBtn.disabled = i <= 0;                 // → newer
    };

    const open = (issue: string | null) => {
      const i = order.indexOf(issue);
      if (i < 0) return false;
      if (!drawer.open) { drawer.showModal(); document.documentElement.style.overflow = 'hidden'; }
      render(i);
      if (closeBtn instanceof HTMLElement) closeBtn.focus();
      return true;
    };

    document.querySelectorAll('.poem-card-mini[data-issue]').forEach((card) => {
      card.addEventListener('click', (e) => {
        const me = e as MouseEvent;
        // Let ⌘/ctrl/shift/middle clicks fall through to the permalink (open in new tab)
        if (me.metaKey || me.ctrlKey || me.shiftKey || me.button !== 0) return;
        if (open(card.getAttribute('data-issue'))) me.preventDefault();
      });
    });

    if (prevBtn) prevBtn.addEventListener('click', () => { if (idx < order.length - 1) render(idx + 1); }); // ← older
    if (nextBtn) nextBtn.addEventListener('click', () => { if (idx > 0) render(idx - 1); });                 // → newer
    drawer.addEventListener('keydown', (e) => {
      const ke = e as KeyboardEvent;
      if (ke.key === 'ArrowLeft' && idx < order.length - 1) render(idx + 1);   // ← older
      else if (ke.key === 'ArrowRight' && idx > 0) render(idx - 1);            // → newer
    });

    const close = () => { if (drawer.open) drawer.close(); };
    if (closeBtn) closeBtn.addEventListener('click', close);
    // click on the backdrop (the dialog element itself, outside the panel content)
    drawer.addEventListener('click', (e) => { if (e.target === drawer) close(); });
    drawer.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      bodyEl.replaceChildren();
      idx = -1;
    });
  })();
</script>
