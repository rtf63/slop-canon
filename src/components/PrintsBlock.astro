---
// Prints teaser. The shop sells the poems as objects — letterpress-style
// broadsides, cards, and the annual anthology. Links out to Shopify at launch
// (product creation is the pipeline's job). TODO(M3): real storefront URLs.
---
<section id="shop" class="wrap">
  <div class="band-label">
    <span class="txt">The Shop</span>
    <span class="rule"></span>
    <span class="chip green">prints &amp; anthology</span>
  </div>
  <div class="prints">
    <div class="print-copy">
      <h2>Take a poem home with you</h2>
      <p>Some poems deserve a wall. Every day's poem can come as a letterpress-style broadside or a folding card, and the whole year collects into an annual anthology. If a machine's going to make things, at least let a few of them be real objects you can hold.</p>
      <div class="print-links">
        <a href="#shop">Poem prints →</a>
        <a href="#shop">Cards &amp; postcards →</a>
        <a href="#shop">The 2026 anthology →</a>
      </div>
    </div>
    <div class="print-art">
      <div class="sticker poem-print">
        <span class="issue-tag">Nº000 ✎</span>
        <p>only that it is warm,<br />only that it is bright.</p>
      </div>
      <div class="sticker poem-print">
        <p>The real warmth<br />is dumber, and kind.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .poem-print{aspect-ratio:4/5;display:flex;align-items:center;justify-content:center;padding:22px}
  .poem-print p{
    font-family:var(--serif);font-style:italic;font-size:17px;line-height:1.5;
    color:var(--ink);text-align:center;margin:0;
  }
</style>
