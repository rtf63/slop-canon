---
// The shop — not open yet. Poems will become objects (broadsides, cards, the
// annual anthology) later; for now this is a "coming soon" surface.
---
<section id="shop" class="wrap">
  <div class="band-label">
    <span class="txt">The Shop</span>
    <span class="rule"></span>
    <span class="chip green">coming soon</span>
  </div>
  <div class="prints">
    <div class="print-copy">
      <h2>Prints &amp; the anthology — coming soon</h2>
      <p>One day the poems will become things you can hold: letterpress-style broadsides, folding cards, and an annual anthology. It's not open yet. For now the poems are free — one a day, right here.</p>
    </div>
    <div class="print-art">
      <div class="sticker poem-print">
        <span class="issue-tag">soon ✎</span>
        <p>only that it is warm,<br />only that it is bright.</p>
      </div>
      <div class="sticker poem-print">
        <p>The real warmth<br />is dumber, and kind.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .poem-print{aspect-ratio:4/5;display:flex;align-items:center;justify-content:center;padding:22px}
  .poem-print p{
    font-family:var(--serif);font-style:italic;font-size:17px;line-height:1.5;
    color:var(--ink);text-align:center;margin:0;
  }
</style>
