---
import { TIP_URL, TIP_LABEL, SUBSTACK_URL } from '../lib/site';
interface Props { nav?: 'today' | 'prints'; }
const { nav } = Astro.props;
---
<header class="top">
  <div class="top-in">
    <a class="logo" href="/">
      <svg class="eye" viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="20" r="18" fill="var(--yellow)" stroke="var(--ink)" stroke-width="3" />
        <ellipse cx="20" cy="20" rx="9" ry="12" fill="var(--cream)" stroke="var(--ink)" stroke-width="2.5" />
        <circle cx="20" cy="20" r="4.5" fill="var(--pink)" stroke="var(--ink)" stroke-width="2" />
      </svg>
      Slop Canon
    </a>
    <nav class="top-nav">
      <a href="/#todays-drop" aria-current={nav === 'today' ? 'page' : undefined}>Today</a>
      <a href="/#shop">Shop</a>
      <a href={TIP_URL} target="_blank" rel="noopener" title={TIP_LABEL}>Tip ☕</a>
      <a href={SUBSTACK_URL} target="_blank" rel="noopener" class="btn pink">Subscribe →</a>
    </nav>
  </div>
</header>
